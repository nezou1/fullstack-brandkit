# FullStack BrandKit — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs

# Gemini API Key (Google AI Studio → https://aistudio.google.com/app/apikey)
# Utilisé pour la génération de palettes et duos de polices
GEMINI_API_KEY=your_gemini_api_key_here

# Alias Vercel AI SDK (même clé, les deux noms sont acceptés)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# (Optionnel) Base path si déployé dans un sous-dossier
# NEXT_PUBLIC_BASE_PATH=
