          },
          "blocks": {
            "accordion_ceYJJq": {
              "type": "_accordion",
              "settings": {
                "show_on_display": "desktop_and_mobile",
                "heading": "Politique de retour",
                "heading_tag": "p",
                "heading_style": "paragraph",
                "open_by_default": false,
                "icon": "none",
                "icon_custom": "",
                "additional_class": ""
              },
              "blocks": {
                "text_ACeCth": {
                  "type": "text",
                  "settings": {
                    "show_on_display": "desktop_and_mobile",
                    "text": "<p>Notre objectif est que chaque client soit totalement satisfait de son achat. Si ce n'est pas le cas, faites-le nous savoir et nous ferons de notre mieux pour trouver une solution avec vous.</p>",
                    "text_style": "paragraph",
                    "paragraph_font_size": "normal",
                    "font_weight": 400,
                    "alignment": "left",
                    "alignment_mobile": "left",
                    "show_read_more": false,
                    "read_more_length": 50,
                    "read_more_text": "Voir plus",
                    "read_less_text": "Voir moins",
                    "truncate": false,
                    "truncate_length": 2,
                    "margin_top": 0,
                    "margin_bottom": 0,
                    "additional_class": ""
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_ACeCth"
              ]
            },
            "accordion_BwgeQe": {
              "type": "_accordion",
              "settings": {
                "show_on_display": "desktop_and_mobile",
                "heading": "Livraison",
                "heading_tag": "p",
                "heading_style": "paragraph",
                "open_by_default": false,
                "icon": "none",
                "icon_custom": "",
                "additional_class": ""
              },
              "blocks": {
                "text_m9VAaR": {
                  "type": "text",
                  "settings": {
                    "show_on_display": "desktop_and_mobile",
                    "text": "<p>Nous travaillons rapidement pour envoyer votre commande dès que possible. Une fois votre commande expédiée, vous recevrez un email avec des informations supplémentaires. Les délais de livraison varient en fonction de votre emplacement.</p>",
                    "text_style": "paragraph",
                    "paragraph_font_size": "normal",
                    "font_weight": 400,
                    "alignment": "left",
                    "alignment_mobile": "left",
                    "show_read_more": false,
                    "read_more_length": 50,
                    "read_more_text": "Voir plus",
                    "read_less_text": "Voir moins",
